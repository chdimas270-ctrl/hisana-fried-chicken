# Salin file ini menjadi ".env" lalu isi nilainya sendiri. JANGAN commit file .env ke git.

# Port server
PORT=3000

# Kunci rahasia untuk session admin (isi string acak panjang, minimal 32 karakter)
SESSION_SECRET=ganti-dengan-string-acak-yang-sangat-panjang-dan-rahasia

# Password admin (TEKS BIASA hanya saat setup pertama)
# Jalankan "node hash-password.js NamaPasswordAnda" untuk membuat hash,
# lalu tempel hasilnya di ADMIN_PASSWORD_HASH di bawah dan HAPUS baris ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
