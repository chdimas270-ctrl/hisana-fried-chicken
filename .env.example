# ==============================================================================
# HISANA FRIED CHICKEN CIREBON - RECRUITMENT PORTAL
# Konfigurasi Environment Variable (.env)
# ==============================================================================
# Salin file ini menjadi ".env" di server VPS Anda:
#   cp .env.example .env
# JANGAN pernah meng-commit file ".env" asli ke Git publik!

# Port & Host binding server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Kunci rahasia session admin (Wajib diisi string acak minimal 32 karakter)
# Generate otomatis via terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-yang-sangat-panjang-dan-rahasia-minimal-32-karakter

# Password Hash Admin (bcrypt)
# Jalankan perintah:
#   node hash-password.js "PasswordRahasiaAnda"
# lalu tempel string hash hasil generate ke bawah ini:
ADMIN_PASSWORD_HASH=

# Keamanan HTTPS:
# - Set FORCE_HTTPS=false jika Anda masih mengakses via IP VPS (http://<IP_VPS>:3000)
# - Ubah menjadi FORCE_HTTPS=true setelah domain Anda terpasang SSL / Certbot HTTPS
FORCE_HTTPS=false

# Content Security Policy (CSP):
# - Default 'false' agar stylesheet dan font tidak diblokir saat diakses langsung lewat IP VPS HTTP
# - Set 'true' jika sudah memiliki domain resmi dengan SSL HTTPS
ENABLE_STRICT_CSP=false

# MongoDB Cloud Database (Wajib/Direkomendasikan untuk Vercel Serverless agar data tersimpan permanen):
# Dapatkan gratis 512MB di mongodb.com/cloud/atlas (tanpa kartu kredit).
# Contoh: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
